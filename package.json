{
  "name": "kpn-wagon-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.mjs",
    "test:postgres": "node --test tests/postgres.integration.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "preview:test": "node scripts/test-preview.mjs",
    "test:notifications": "node --test tests/notifications.integration.mjs",
    "notifications:once": "node scripts/notification-worker.mjs --once",
    "notifications:worker": "node scripts/notification-worker.mjs",
    "test:attachments": "node --test tests/attachments.integration.mjs",
    "attachments:scan-once": "node scripts/scan-worker.mjs --once",
    "attachments:scan-worker": "node scripts/scan-worker.mjs",
    "test:staff-auth": "node --test tests/staff-auth.integration.mjs",
    "test:staff-workspace": "node --test tests/staff-workspace.integration.mjs",
    "preview:staff": "node scripts/staff-preview.mjs",
    "staff:bootstrap": "node scripts/bootstrap-staff-owner.mjs",
    "test:staff-http": "node tests/staff-http-smoke.mjs",
    "test:staff-disabled": "node tests/staff-disabled-smoke.mjs",
    "test:quotations": "node --test tests/quotations.integration.mjs",
    "test:quotation-http": "node tests/quotation-http-smoke.mjs",
    "test:content": "node --test tests/content.integration.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "jose": "^6.2.17",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
