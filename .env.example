APP_ENV=development
# Configure only after domain ownership and company content approval.
SITE_URL=
PUBLICATION_APPROVED=false
DATABASE_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
NOTIFICATION_PROVIDER_KEY=

# Intake is off by default; preview:test sets these in memory for synthetic local tests.
QUOTE_INTAKE_MODE=disabled
APP_ORIGIN=http://127.0.0.1:3000
PRIVACY_NOTICE_VERSION=
RATE_LIMIT_SECRET=

# Notification workers are off unless explicitly configured. No live provider used in tests.
NOTIFICATION_MODE=disabled
NOTIFICATION_FROM=
NOTIFICATION_STAFF_EMAIL=
RESEND_API_KEY=
NOTIFICATION_TEMPLATES_APPROVED=false
COMPANY_COMMUNICATIONS_APPROVED=false
# Local scanner worker only; public upload UI remains disabled.
ATTACHMENT_SCANNER_MODE=disabled

# Staff authentication is disabled until a real company provider is configured.
STAFF_AUTH_ENABLED=false
STAFF_DATABASE_URL=
STAFF_ORIGIN=
STAFF_SESSION_KEY=
OIDC_MFA_ACR_VALUES=
OIDC_ALLOW_LOOPBACK_TEST=false
# For an explicit initial Owner registry setup only (no defaults).
BOOTSTRAP_STAFF_SUBJECT=
BOOTSTRAP_STAFF_NAME=

# Quotation issuance stays disabled until company template and services are approved.
QUOTATION_MODE=disabled
COMPANY_QUOTATION_APPROVED=false
QUOTATION_EVIDENCE_ROOT=

# Content stays private until explicitly enabled and company content is approved
CMS_MODE=disabled
CMS_DATABASE_URL=
COMPANY_PUBLICATION_APPROVED=false

# SEO release gates: leave closed until actual domain/content/staging checks are approved.
# Use the exact approved HTTPS origin; no path, credentials or placeholder domains.
PUBLIC_SITE_URL=
PUBLIC_SITE_DOMAIN_APPROVED=false
SEO_INDEXING_ENABLED=false

# Security: production auth requires HMAC-attested client IP from an approved trusted edge.
STAFF_EDGE_KEY=
# Loopback development CSP self-test is disabled unless explicitly enabled in test preview.
CSP_LOCAL_TEST=false
